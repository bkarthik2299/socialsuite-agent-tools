SOCIALSUITE_SUPABASE_URL=https://your-project-ref.supabase.co
SOCIALSUITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Use a dedicated SocialSuite user. Do not use an owner/personal account for shared testing.
SOCIALSUITE_HERMES_EMAIL=agent-user@example.com
SOCIALSUITE_HERMES_PASSWORD=replace-with-agent-user-password

# Optional. Leave blank to use the first workspace membership for the agent user.
SOCIALSUITE_ORG_ID=
SOCIALSUITE_DEFAULT_LIMIT=25

# Reserved for the API-key-authenticated connector mode.
# Do not commit real API keys.
SOCIALSUITE_API_KEY=
